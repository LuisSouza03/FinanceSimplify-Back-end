# FinanceSimplify Environment Variables
# Copy this file to .env and fill in your actual values
# NEVER commit .env files to version control!

# JWT Secret Token (minimum 32 characters recommended)
# Used for signing and validating JWT tokens
AppSettings__Token=YOUR_JWT_SECRET_HERE_MIN_32_CHARS

# MongoDB Connection
# Format: mongodb+srv://username:password@cluster.mongodb.net/
# For local development: mongodb://localhost:27017
MongoDbSettings__ConnectionString=mongodb://localhost:27017
MongoDbSettings__DatabaseName=FinanceSimplify

# ASP.NET Core Environment
# Values: Development, Staging, Production
ASPNETCORE_ENVIRONMENT=Development

# Logging Level
# Values: Information, Debug, Warning, Error, Critical
LOGGING__LOGLEVEL__DEFAULT=Information
